{
  "name": "terminal221b",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "cli": "npm run start --workspace @terminal221b/cli --",
    "build:cli": "npm run build --workspace @terminal221b/cli",
    "tui": "cargo run -p terminal221b-tui --",
    "build:tui": "cargo build --release -p terminal221b-tui",
    "lint:shell": "shellcheck packages/cli/resources/*.sh",
    "lint": "eslint App.tsx index.ts src packages/cli/src packages/cli/tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @terminal221b/cli",
    "build": "expo export --platform web",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "workspaces": [
    "packages/cli"
  ],
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.3.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quattro-Commas/terminal221b.git"
  },
  "homepage": "https://github.com/Quattro-Commas/terminal221b",
  "bugs": {
    "url": "https://github.com/Quattro-Commas/terminal221b/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.28",
    "image-size": "2.0.3",
    "uuid": "11.1.1"
  }
}
